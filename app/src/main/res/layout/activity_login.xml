<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ECOMER" android:textSize="28sp" android:layout_marginBottom="24dp"/>

    <EditText android:id="@+id/edtEmail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Email"
        android:inputType="textEmailAddress"/>

    <EditText android:id="@+id/edtPass" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Mật khẩu (tối thiểu 6 ký tự)"
        android:inputType="textPassword"/>

    <Button android:id="@+id/btnLogin" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="ĐĂNG NHẬP"
        android:layout_marginTop="16dp"/>

    <Button android:id="@+id/btnRegister" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="ĐĂNG KÝ"/>

</LinearLayout>